{
  "name": "paged-react",
  "version": "0.1.3",
  "description": "React components for print-ready documents with automatic pagination.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/inj-src/paged-react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inj-src/paged-react.git",
    "directory": "packages/paged-react"
  },
  "bugs": {
    "url": "https://github.com/inj-src/paged-react/issues"
  },
  "keywords": [
    "react",
    "pagination",
    "print",
    "paged-media",
    "pdf"
  ],
  "sideEffects": [
    "./dist/styles.css",
    "./src/styles.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/styles.css dist/styles.css",
    "dev": "node scripts/dev.mjs",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.5.0",
    "jsdom": "^27.0.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
